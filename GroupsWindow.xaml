<Window x:Class="Névjegyzék.GroupsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Névjegyzék"
        Title="Névjegycsoportok Kezelése" Height="650" Width="1100"
        Background="#F3F3F3" WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <local:GroupsViewModel />
    </Window.DataContext>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1.2*" />
            <ColumnDefinition Width="1.2*" />
            <ColumnDefinition Width="1.5*" />
        </Grid.ColumnDefinitions>

        <GroupBox Header=" Csoportok " Grid.Column="0" Margin="4" Padding="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" DisplayMemberPath="Name" Margin="0,0,0,6" Background="White" BorderBrush="#E0E0E0"/>

                <UniformGrid Grid.Row="1" Columns="3">
                    <Button Content="Új..." Command="{Binding OpenAddGroupWindowCommand}" Margin="1"/>
                    <Button Content="Módosít..." Command="{Binding OpenEditGroupWindowCommand}" Margin="1"/>
                    <Button Content="Töröl" Command="{Binding DeleteGroupCommand}" Margin="1"/>
                </UniformGrid>
            </Grid>
        </GroupBox>

        <GroupBox Header=" Csoport Tagjai " Grid.Column="1" Margin="4" Padding="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListBox ItemsSource="{Binding GroupSelectableContacts}" Margin="0,0,0,6" Background="White" BorderBrush="#E0E0E0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Image Source="{Binding Contact.ImagePath}" Width="20" Height="20" Stretch="UniformToFill" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Contact.Name}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Grid.Row="1" Content="Kijelöltek eltávolítása" Command="{Binding RemoveSelectedContactsFromGroupCommand}" Height="30" Background="#E81123" Foreground="White" FontWeight="SemiBold"/>
            </Grid>
        </GroupBox>

        <GroupBox Header=" Névjegyek Hozzáadása " Grid.Column="2" Margin="4" Padding="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListBox ItemsSource="{Binding AvailableContacts}" Margin="0,0,0,6" Background="White" BorderBrush="#E0E0E0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Image Source="{Binding Contact.ImagePath}" Width="20" Height="20" Stretch="UniformToFill" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Contact.Name}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Grid.Row="1" Content="Kijelöltek hozzáadása" Command="{Binding AddSelectedContactsCommand}" Height="30" Background="#007ACC" Foreground="White" FontWeight="SemiBold"/>
            </Grid>
        </GroupBox>

        <GroupBox Header=" Csoport Jegyzetei " Grid.Column="3" Margin="4" Padding="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.2*" />
                    <RowDefinition Height="1.3*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListBox ItemsSource="{Binding SelectableNotes}" 
                         SelectedItem="{Binding SelectedSelectableNote}" 
                         Margin="0,0,0,6"
                         Background="White" BorderBrush="#E0E0E0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding IsSelectedForDelete, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Note.Title}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6">
                    <StackPanel Margin="4">
                        <TextBlock Text="Cím:" FontWeight="Bold" Foreground="#555555"/>
                        <TextBlock Text="{Binding SelectedSelectableNote.Note.Title}" FontSize="14" Margin="0,0,0,6" TextWrapping="Wrap"/>

                        <TextBlock Text="Leírás:" FontWeight="Bold" Foreground="#555555"/>
                        <TextBlock Text="{Binding SelectedSelectableNote.Note.Description}" FontSize="14" Margin="0,0,0,6" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>

                <UniformGrid Grid.Row="2" Columns="3" Height="32">
                    <Button Content="Új Jegyzet..." Command="{Binding OpenAddNoteWindowCommand}" Margin="1"/>
                    <Button Content="Módosítás..." Command="{Binding OpenEditNoteWindowCommand}" Margin="1"/>
                    <Button Content="Kijelöltek Törlése" Command="{Binding DeleteSelectedNotesCommand}" Margin="1"/>
                </UniformGrid>
            </Grid>
        </GroupBox>
    </Grid>
</Window>