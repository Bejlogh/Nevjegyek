<Window x:Class="Névjegyzék.NotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Névjegyzék"
        Title="Jegyzetek Kezelése" Height="550" Width="760"
        Background="#F3F3F3" WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <local:NotesViewModel />
    </Window.DataContext>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="1.8*"/>
        </Grid.ColumnDefinitions>

        <GroupBox Header=" Névjegyek (Válasszon ki egyet) " Grid.Column="0" Margin="4" Padding="8">
            <ListBox ItemsSource="{Binding Contacts}" 
                     SelectedItem="{Binding SelectedContact}" 
                     Background="White" BorderBrush="#E0E0E0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding ImageSource}" Width="20" Height="20" Stretch="UniformToFill" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>

        <GroupBox Header=" Jegyzetek Kezelése " Grid.Column="1" Margin="4" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.2*"/>
                    <RowDefinition Height="1.3*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListBox ItemsSource="{Binding SelectableNotes}" 
                         SelectedItem="{Binding SelectedSelectableNote}" 
                         Margin="0,0,0,8"
                         Background="White" BorderBrush="#E0E0E0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding IsSelectedForDelete, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Note.Title}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
                    <StackPanel Margin="4">
                        <TextBlock Text="Cím:" FontWeight="Bold" Foreground="#555555"/>
                        <TextBlock Text="{Binding SelectedSelectableNote.Note.Title}" FontSize="14" Margin="0,0,0,6" TextWrapping="Wrap"/>

                        <TextBlock Text="Leírás:" FontWeight="Bold" Foreground="#555555"/>
                        <TextBlock Text="{Binding SelectedSelectableNote.Note.Description}" FontSize="14" Margin="0,0,0,6" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>

                <UniformGrid Grid.Row="2" Columns="3" Height="34">
                    <Button Content="Új Jegyzet..." Command="{Binding OpenAddWindowCommand}" Margin="2"/>
                    <Button Content="Módosítás..." Command="{Binding OpenEditWindowCommand}" Margin="2"/>
                    <Button Content="Kijelöltek Törlése" Command="{Binding DeleteSelectedNotesCommand}" Margin="2"/>
                </UniformGrid>
            </Grid>
        </GroupBox>
    </Grid>
</Window>