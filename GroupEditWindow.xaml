<Window x:Class="Névjegyzék.GroupEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Csoport Szerkesztése" Height="200" Width="380" MinWidth="380" MinHeight="200"
        Background="#F3F3F3" WindowStartupLocation="CenterScreen"> 

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel VerticalAlignment="Center">
            <Label Content="Csoport neve:" Foreground="#555555" Padding="0,0,0,2"/>
            <TextBox Text="{Binding GroupName, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="2" Height="34">
            <Button Content="Mentés" Command="{Binding SaveCommand}" Margin="2" Background="#007ACC" Foreground="White" FontWeight="Bold"/>
            <Button Content="Mégse" Command="{Binding CancelCommand}" Margin="2"/>
        </UniformGrid>
    </Grid>
</Window>