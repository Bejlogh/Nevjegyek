<Window x:Class="Névjegyzék.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Névjegyzék"
        Title="Névjegyzék Kezelő - Főoldal" Height="320" Width="400" MinWidth="400" MinHeight="320"
        Background="#F3F3F3" WindowStartupLocation="CenterScreen"> 

    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="280">
        <TextBlock Text="Válasszon funkciót:" FontSize="18" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,20" TextAlignment="Center"/>
        <Button Content="Névjegyek Kezelése" Command="{Binding OpenContactsCommand}" Height="40" Margin="0,0,0,10" Background="#007ACC" Foreground="White" FontWeight="SemiBold" Cursor="Hand"/>
        <Button Content="Jegyzetek Kezelése" Command="{Binding OpenNotesCommand}" Height="40" Margin="0,0,0,10" Background="#007ACC" Foreground="White" FontWeight="SemiBold" Cursor="Hand"/>
        <Button Content="Csoportok Kezelése" Command="{Binding OpenGroupsCommand}" Height="40" Background="#007ACC" Foreground="White" FontWeight="SemiBold" Cursor="Hand"/>
    </StackPanel>
</Window>