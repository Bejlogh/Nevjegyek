<Window x:Class="Névjegyzék.ContactEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Névjegy Szerkesztése" Height="620" Width="400"
        Background="#F3F3F3" WindowStartupLocation="CenterScreen">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Label Content="Profilkép:" Foreground="#555555" Padding="0,0,0,2"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8" HorizontalAlignment="Center">
                    <Border Width="70" Height="70" Background="#E0E0E0" CornerRadius="35" ClipToBounds="True" Margin="0,0,8,0">
                        <Image Source="{Binding ContactImageSource}" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <Button Content="Feltöltés" Command="{Binding UploadImageCommand}" Width="90" Height="26" Margin="0,0,0,4"/>
                        <Button Content="Kép Törlése" Command="{Binding DeleteImageCommand}" Width="90" Height="26"/>
                    </StackPanel>
                </StackPanel>

                <Label Content="Név:" Foreground="#555555" Padding="0,0,0,2"/>
                <TextBox Text="{Binding ContactName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>

                <Label Content="Email:" Foreground="#555555" Padding="0,0,0,2"/>
                <TextBox Text="{Binding ContactEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>

                <Label Content="Telefonszám:" Foreground="#555555" Padding="0,0,0,2"/>
                <TextBox Text="{Binding ContactPhone, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>

                <Label Content="Pozíció:" Foreground="#555555" Padding="0,0,0,2"/>
                <TextBox Text="{Binding ContactPosition, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>

                <Label Content="Lakhely:" Foreground="#555555" Padding="0,0,0,2"/>
                <TextBox Text="{Binding ContactAddress, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>

                <Label Content="Születési dátum (ÉÉÉÉ-HH-NN):" Foreground="#555555" Padding="0,0,0,2"/>
                <DatePicker SelectedDate="{Binding ContactBirthDate, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>

                <Label Content="Webhely:" Foreground="#555555" Padding="0,0,0,2"/>
                <TextBox Text="{Binding ContactWebsite, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>

                <CheckBox Content="Letiltás" IsChecked="{Binding IsBlocked, Mode=TwoWay}" Margin="2,6,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <UniformGrid Grid.Row="1" Columns="2" Height="34" Margin="0,8,0,0">
            <Button Content="Mentés" Command="{Binding SaveCommand}" Margin="2" Background="#007ACC" Foreground="White" FontWeight="Bold"/>
            <Button Content="Mégse" Command="{Binding CancelCommand}" Margin="2"/>
        </UniformGrid>
    </Grid>
</Window>