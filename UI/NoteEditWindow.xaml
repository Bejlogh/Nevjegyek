<Window x:Class="Névjegyzék.NoteEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jegyzet Szerkesztése" Height="380" Width="400" MinWidth="400" MinHeight="380"
        Background="#F3F3F3" WindowStartupLocation="CenterScreen"> 

    <Window.Resources>
        <ControlTemplate x:Key="ValidationErrorTemplate">
            <Grid Margin="0,0,0,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        BorderBrush="#D32F2F"
                        BorderThickness="1"
                        CornerRadius="3"
                        SnapsToDevicePixels="True">
                    <AdornedElementPlaceholder x:Name="placeholder"/>
                </Border>

                <TextBlock Grid.Row="1"
                           Text="{Binding ElementName=placeholder, Path=AdornedElement.(Validation.Errors)[0].ErrorContent}"
                           Foreground="#D32F2F"
                           FontSize="11"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"/>
            </Grid>
        </ControlTemplate>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <StackPanel Margin="0,0,0,18">
                <Label Content="Jegyzet címe:" Foreground="#555555" Padding="0,0,0,2"/>
                <TextBox Text="{Binding NoteTitle, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                         Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,8">
                <Label Content="Leírás:" Foreground="#555555" Padding="0,0,0,2"/>
                <TextBox Text="{Binding NoteDescription, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                         Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}" Height="150" AcceptsReturn="True" TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="2" Height="34" Margin="0,8,0,0">
            <Button Content="Mentés" Command="{Binding SaveCommand}" Margin="2" Background="#007ACC" Foreground="White" FontWeight="Bold"/>
            <Button Content="Mégse" Command="{Binding CancelCommand}" Margin="2"/>
        </UniformGrid>
    </Grid>
</Window>































































































































































































































































































































