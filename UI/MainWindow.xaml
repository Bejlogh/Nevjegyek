<Window x:Class="Névjegyzék.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Névjegyzék"
        Title="{DynamicResource MainWindow_Title}" Height="360" Width="420" MinWidth="420" MinHeight="360"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource ModernBackgroundBrush}">

    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>

    <Border Margin="18" CornerRadius="20" Padding="20" Background="{DynamicResource ModernPanelBrush}" BorderBrush="{DynamicResource ModernBorderBrush}" BorderThickness="1">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
            <TextBlock Text="{DynamicResource MainWindow_SelectFunction}" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" TextAlignment="Center"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                <TextBlock Text="{DynamicResource MainWindow_LanguageLabel}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource ModernMutedBrush}"/>
                <ComboBox Width="120"
                          ItemsSource="{Binding AvailableLanguages}"
                          DisplayMemberPath="Value"
                          SelectedValuePath="Key"
                          SelectedValue="{Binding SelectedLanguageCode, Mode=TwoWay}"/>
            </StackPanel>

            <Button Content="{DynamicResource MainWindow_ManageContacts}" Command="{Binding OpenContactsCommand}" Height="42" Margin="0,0,0,10" Style="{StaticResource RegularButtonStyle}"/>
            <Button Content="{DynamicResource MainWindow_ManageNotes}" Command="{Binding OpenNotesCommand}" Height="42" Margin="0,0,0,10" Style="{StaticResource RegularButtonStyle}"/>
            <Button Content="{DynamicResource MainWindow_ManageGroups}" Command="{Binding OpenGroupsCommand}" Height="42" Style="{StaticResource RegularButtonStyle}"/>
        </StackPanel>
    </Border>
</Window>
