<Window x:Class="Névjegyzék.ContactsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Névjegyzék"
        Title="{DynamicResource ContactsWindow_Title}" Height="650" Width="700" MinWidth="700" MinHeight="650"
        Background="#F3F3F3" WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <local:ContactsViewModel />
    </Window.DataContext>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="1.8*"/>
        </Grid.ColumnDefinitions>

        <GroupBox Header="{DynamicResource ContactsWindow_Contacts}" Grid.Column="0" Margin="4" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListBox ItemsSource="{Binding Contacts}"
                         SelectedItem="{Binding SelectedContact}"
                         Margin="0,0,0,8"
                         Background="White"
                         BorderBrush="#E0E0E0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding IsSelectedForDelete, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Image Source="{Binding Contact.ImageSource}" Width="20" Height="20" Stretch="UniformToFill" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="NameTxt" Text="{Binding Contact.Name}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="BlockedTxt" Text="{DynamicResource ContactsWindow_BlockedSuffix}" Foreground="Gray" VerticalAlignment="Center" Visibility="Collapsed" Margin="4,0,0,0"/>

                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Contact.IsBlocked}" Value="True">
                                    <Setter TargetName="NameTxt" Property="Foreground" Value="Gray"/>
                                    <Setter TargetName="BlockedTxt" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <UniformGrid Grid.Row="1" Columns="3" Height="42">
                    <Button Content="{DynamicResource ContactsWindow_Delete}"
                        Command="{Binding DeleteSelectedContactsCommand}"
                            Style="{DynamicResource DangerButtonStyle}"
                        Margin="4,2"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"/>
                    <Button Content="{DynamicResource ContactsWindow_Block}"
                        Command="{Binding BlockSelectedContactsCommand}"
                        Style="{DynamicResource RegularButtonStyle}"
                        Margin="4,2"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"/>
                    <Button Content="{DynamicResource ContactsWindow_Unblock}"
                        Command="{Binding UnblockSelectedContactsCommand}"
                        Style="{DynamicResource RegularButtonStyle}"
                        Margin="4,2"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"/>
                </UniformGrid>
            </Grid>
        </GroupBox>

        <GroupBox Header="{DynamicResource ContactsWindow_Details}" Grid.Column="1" Margin="4" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <Border Width="80" Height="80" Background="#E0E0E0" CornerRadius="40" HorizontalAlignment="Center" ClipToBounds="True" Margin="0,0,0,16">
                            <Image Source="{Binding SelectedContact.Contact.ImageSource}" Stretch="UniformToFill"/>
                        </Border>

                        <TextBlock Text="{DynamicResource ContactsWindow_Name}" FontWeight="Bold" Foreground="#555555"/>
                        <Label Content="{Binding SelectedContact.Contact.Name}" FontSize="14" Margin="0,0,0,8" Padding="0"/>

                        <TextBlock Text="{DynamicResource ContactsWindow_Email}" FontWeight="Bold" Foreground="#555555"/>
                        <Label Content="{Binding SelectedContact.Contact.Email}" FontSize="14" Margin="0,0,0,8" Padding="0"/>

                        <TextBlock Text="{DynamicResource ContactsWindow_Phone}" FontWeight="Bold" Foreground="#555555"/>
                        <Label Content="{Binding SelectedContact.Contact.Phone}" FontSize="14" Margin="0,0,0,8" Padding="0"/>

                        <TextBlock Text="{DynamicResource ContactsWindow_Position}" FontWeight="Bold" Foreground="#555555"/>
                        <Label Content="{Binding SelectedContact.Contact.Position}" FontSize="14" Margin="0,0,0,8" Padding="0"/>

                        <TextBlock Text="{DynamicResource ContactsWindow_Address}" FontWeight="Bold" Foreground="#555555"/>
                        <Label Content="{Binding SelectedContact.Contact.Address}" FontSize="14" Margin="0,0,0,8" Padding="0"/>

                        <TextBlock Text="{DynamicResource ContactsWindow_BirthDate}" FontWeight="Bold" Foreground="#555555"/>
                        <Label Content="{Binding SelectedContact.Contact.BirthDate}" FontSize="14" Margin="0,0,0,8" Padding="0"/>

                        <TextBlock Text="{DynamicResource ContactsWindow_Website}" FontWeight="Bold" Foreground="#555555"/>
                        <Label Content="{Binding SelectedContact.Contact.Website}" FontSize="14" Margin="0,0,0,8" Padding="0"/>

                        <TextBlock Text="{DynamicResource ContactsWindow_StatusBlocked}" FontWeight="Bold" Foreground="#555555"/>
                        <CheckBox IsChecked="{Binding SelectedContact.Contact.IsBlocked}" IsEnabled="False" Margin="0,0,0,8"/>
                    </StackPanel>
                </ScrollViewer>

                <UniformGrid Grid.Row="1" Columns="2" Height="42" Margin="0,8,0,0">
                    <Button Content="{DynamicResource ContactsWindow_NewContact}"
                            Command="{Binding OpenAddWindowCommand}"
                            Style="{DynamicResource RegularButtonStyle}"
                            Margin="2"
                            Width="160"
                            HorizontalContentAlignment="Center"/>
                    <Button Content="{DynamicResource ContactsWindow_EditContact}"
                            Command="{Binding OpenEditWindowCommand}"
                            Style="{DynamicResource RegularButtonStyle}"
                            Margin="2"
                            Width="160"
                            HorizontalContentAlignment="Center"/>
                </UniformGrid>
            </Grid>
        </GroupBox>
    </Grid>
</Window>