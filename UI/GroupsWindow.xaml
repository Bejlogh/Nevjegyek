<Window x:Class="Névjegyzék.GroupsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Névjegyzék"
        Title="{DynamicResource GroupsWindow_Title}" Height="650" Width="1100" MinWidth="1100" MinHeight="650"
        Background="#F3F3F3" WindowStartupLocation="CenterScreen"> 

    <Window.DataContext>
        <local:GroupsViewModel />
    </Window.DataContext>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1.2*" />
            <ColumnDefinition Width="1.2*" />
            <ColumnDefinition Width="1.5*" />
        </Grid.ColumnDefinitions>

        <GroupBox Header="{DynamicResource GroupsWindow_Groups}" Grid.Column="0" Margin="4" Padding="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" DisplayMemberPath="Name" Margin="0,0,0,6" Background="White" BorderBrush="#E0E0E0"/>

                <UniformGrid Grid.Row="2" Columns="3" Height="42">
                    <Button Content="{DynamicResource GroupsWindow_New}" Command="{Binding OpenAddGroupWindowCommand}" Margin="4,2" Height="38" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Style="{StaticResource RegularButtonStyle}"/>
                    <Button Content="{DynamicResource GroupsWindow_Edit}" Command="{Binding OpenEditGroupWindowCommand}" Margin="4,2" Height="38" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Style="{StaticResource RegularButtonStyle}"/>
                    <Button Content="{DynamicResource GroupsWindow_Delete}" Command="{Binding DeleteGroupCommand}" Margin="4,2" Height="38" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Style="{StaticResource DangerButtonStyle}"/>
                </UniformGrid>
            </Grid>
        </GroupBox>

        <GroupBox Header="{DynamicResource GroupsWindow_Members}" Grid.Column="1" Margin="4" Padding="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListBox x:Name="GroupMembersList"
                         ItemsSource="{Binding GroupSelectableContacts}"
                         Margin="0,0,0,6"
                         Background="White"
                         BorderBrush="#E0E0E0"
                         AllowDrop="True"
                         DragEnter="GroupMembersList_DragEnter"
                         DragOver="GroupMembersList_DragOver"
                         Drop="GroupMembersList_Drop">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Image Source="{Binding Contact.ImageSource}" Width="20" Height="20" Stretch="UniformToFill" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Contact.Name}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Grid.Row="1" Content="{DynamicResource GroupsWindow_RemoveSelected}" Command="{Binding RemoveSelectedContactsFromGroupCommand}" Height="38" Width="220" Margin="0,4,0,0" HorizontalContentAlignment="Center" Style="{StaticResource DangerButtonStyle}"/>
            </Grid>
        </GroupBox>

        <GroupBox Header="{DynamicResource GroupsWindow_AddContacts}" Grid.Column="2" Margin="4" Padding="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListBox x:Name="AvailableContactsList"
                         ItemsSource="{Binding AvailableContacts}"
                         Margin="0,0,0,6"
                         Background="White"
                         BorderBrush="#E0E0E0"
                         PreviewMouseLeftButtonDown="AvailableContactsList_PreviewMouseLeftButtonDown"
                         PreviewMouseLeftButtonUp="AvailableContactsList_PreviewMouseLeftButtonUp"
                         PreviewMouseMove="AvailableContactsList_PreviewMouseMove"
                         Focusable="False">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,4,0"
                                          Focusable="False"
                                          PreviewMouseLeftButtonDown="AvailableContactCheckBox_PreviewMouseLeftButtonDown"
                                          PreviewMouseLeftButtonUp="AvailableContactCheckBox_PreviewMouseLeftButtonUp"/>
                                <Image Source="{Binding Contact.ImageSource}" Width="20" Height="20" Stretch="UniformToFill" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Contact.Name}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Grid.Row="1" Content="{DynamicResource GroupsWindow_AddSelected}" Command="{Binding AddSelectedContactsCommand}" Height="38" Width="220" Margin="0,4,0,0" HorizontalContentAlignment="Center" Style="{StaticResource RegularButtonStyle}"/>
            </Grid>
        </GroupBox>

        <GroupBox Header="{DynamicResource GroupsWindow_GroupNotes}" Grid.Column="3" Margin="4" Padding="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.2*" />
                    <RowDefinition Height="1.3*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListBox ItemsSource="{Binding SelectableNotes}" 
                         SelectedItem="{Binding SelectedSelectableNote}" 
                         Margin="0,0,0,6"
                         Background="White" BorderBrush="#E0E0E0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding IsSelectedForDelete, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Note.Title}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6">
                    <StackPanel Margin="4">
                        <TextBlock Text="{DynamicResource GroupsWindow_NoteTitle}" FontWeight="Bold" Foreground="#555555"/>
                        <TextBlock Text="{Binding SelectedSelectableNote.Note.Title}" FontSize="14" Margin="0,0,0,6" TextWrapping="Wrap"/>

                        <TextBlock Text="{DynamicResource GroupsWindow_NoteDescription}" FontWeight="Bold" Foreground="#555555"/>
                        <TextBlock Text="{Binding SelectedSelectableNote.Note.Description}" FontSize="14" Margin="0,0,0,6" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>

                <UniformGrid Grid.Row="2" Columns="3" Height="42">
                    <Button Content="{DynamicResource GroupsWindow_AddNote}" Command="{Binding OpenAddNoteWindowCommand}" Margin="4,2" Height="38" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Style="{StaticResource RegularButtonStyle}"/>
                    <Button Content="{DynamicResource GroupsWindow_EditNote}" Command="{Binding OpenEditNoteWindowCommand}" Margin="4,2" Height="38" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Style="{StaticResource RegularButtonStyle}"/>
                    <Button Content="{DynamicResource GroupsWindow_DeleteNotes}" Command="{Binding DeleteSelectedNotesCommand}" Margin="4,2" Height="38" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Style="{StaticResource DangerButtonStyle}"/>
                </UniformGrid>
            </Grid>
        </GroupBox>
    </Grid>
</Window>