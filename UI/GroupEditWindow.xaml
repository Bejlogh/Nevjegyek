<Window x:Class="Névjegyzék.GroupEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource GroupEditWindow_Title}" Height="200" Width="380" MinWidth="380" MinHeight="200"
        Background="#F3F3F3" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="SaveButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#B8B8B8"/>
                    <Setter Property="Foreground" Value="#5F5F5F"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <ControlTemplate x:Key="ValidationErrorTemplate">
            <Grid Margin="0,0,0,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        BorderBrush="#D32F2F"
                        BorderThickness="1"
                        CornerRadius="3"
                        SnapsToDevicePixels="True">
                    <AdornedElementPlaceholder x:Name="placeholder"/>
                </Border>

                <TextBlock Grid.Row="1"
                           Text="{Binding ElementName=placeholder, Path=AdornedElement.(Validation.Errors)[0].ErrorContent}"
                           Foreground="#D32F2F"
                           FontSize="11"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"/>
            </Grid>
        </ControlTemplate>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel VerticalAlignment="Center">
            <StackPanel Margin="0,0,0,16">
                <Label Content="{DynamicResource GroupEditWindow_GroupName}" Foreground="#555555" Padding="0,0,0,2"/>
                <TextBox Text="{Binding GroupName, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                         Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}"/>
            </StackPanel>
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="2" Height="40">
            <Button Content="{DynamicResource GroupEditWindow_Save}" Command="{Binding SaveCommand}" Margin="2" Height="38" MinWidth="120" Style="{StaticResource SaveButtonStyle}"/>
            <Button Content="{DynamicResource GroupEditWindow_Cancel}" Command="{Binding CancelCommand}" Margin="2" Height="38" MinWidth="120" Style="{StaticResource DangerButtonStyle}"/>
        </UniformGrid>
    </Grid>
</Window>